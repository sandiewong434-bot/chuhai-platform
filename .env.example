# ============================================================
# 出海综合服务平台 · 环境变量模板
# 复制为 .env 后按需修改
# ============================================================

# 应用
DEBUG=false
SECRET_KEY=change-me-in-production

# 数据库（Docker Compose 会自动使用这些值创建 PostgreSQL）
POSTGRES_USER=chuhai
POSTGRES_PASSWORD=chuhai
POSTGRES_DB=chuhai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chuhai:chuhai@localhost:5432/chuhai

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# CORS（前端开发服务器地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 服务端口
BACKEND_PORT=8000
NGINX_PORT=80
